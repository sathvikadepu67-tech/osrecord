
#include <stdio.h>
#include <stdlib.h>

int main()
{
    int req[50], visited[50] = {0};
    int n, head, i, j, pos, diff;
    int total = 0, min;

    printf("Enter number of requests: ");
    scanf("%d", &n);

    printf("Enter request sequence:\n");
    for(i = 0; i < n; i++)
        scanf("%d", &req[i]);

    printf("Enter initial head position: ");
    scanf("%d", &head);

    printf("\nSeek Sequence: %d", head);

    for(i = 0; i < n; i++)
    {
        min = 999999;
        pos = -1;

        for(j = 0; j < n; j++)
        {
            if(!visited[j])
            {
                diff = abs(head - req[j]);

                if(diff < min)
                {
                    min = diff;
                    pos = j;
                }
            }
        }

        visited[pos] = 1;
        total += abs(head - req[pos]);
        head = req[pos];

        printf(" -> %d", head);
    }

    printf("\nTotal Head Movement = %d\n", total);

    return 0;
}
