
#include <stdio.h>

int main()
{
    int n, total, i;
    int frames[10], rem;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    printf("Enter total number of frames: ");
    scanf("%d", &total);

    if(n <= 0 || total < 0)
    {
        printf("Invalid input\n");
        return 1;
    }

    rem = total % n;

    printf("\nProcess\tFrames Allocated\n");

    for(i = 0; i < n; i++)
    {
        frames[i] = total / n;

        if(i < rem)
            frames[i]++;

        printf("P%d\t%d\n", i + 1, frames[i]);
    }

    return 0;
}
