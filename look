
#include <stdio.h>
#include <stdlib.h>

int main()
{
    int a[50], n, head;
    int i, j, temp, total = 0;

    printf("Enter number of requests: ");
    scanf("%d", &n);

    printf("Enter request sequence:\n");
    for(i = 0; i < n; i++)
        scanf("%d", &a[i]);

    printf("Enter initial head position: ");
    scanf("%d", &head);

    for(i = 0; i < n - 1; i++)
        for(j = i + 1; j < n; j++)
            if(a[i] > a[j])
            {
                temp = a[i];
                a[i] = a[j];
                a[j] = temp;
            }

    printf("\nSeek Sequence: %d", head);

    for(i = 0; i < n; i++)
        if(a[i] >= head)
            break;

    for(j = i; j < n; j++)
    {
        total += abs(head - a[j]);
        head = a[j];
        printf(" -> %d", head);
    }

    for(j = i - 1; j >= 0; j--)
    {
        total += abs(head - a[j]);
        head = a[j];
        printf(" -> %d", head);
    }

    printf("\nTotal Head Movement = %d\n", total);

    return 0;
}
