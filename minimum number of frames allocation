
#include <stdio.h>

int main()
{
    int n, i, total = 0;
    int pages[10], frames[10];
    int min = 3;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    printf("Enter number of pages for each process:\n");
    for(i = 0; i < n; i++)
    {
        printf("P%d: ", i + 1);
        scanf("%d", &pages[i]);
        frames[i] = min;
        total += frames[i];
    }

    printf("\nProcess\tPages\tFrames Allocated\n");

    for(i = 0; i < n; i++)
    {
        printf("P%d\t%d\t%d\n",
               i + 1, pages[i], frames[i]);
    }

    printf("Total frames allocated = %d\n", total);

    return 0;
}
