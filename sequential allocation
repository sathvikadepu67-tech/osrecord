
#include <stdio.h>

int main()
{
    int start, len, i;

    printf("Enter starting block: ");
    scanf("%d", &start);

    printf("Enter file length (number of blocks): ");
    scanf("%d", &len);

    printf("\nFile is allocated sequentially:\n");

    for(i = 0; i < len; i++)
    {
        printf("%d ", start + i);
    }

    printf("\n");

    return 0;
}
