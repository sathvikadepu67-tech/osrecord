
#include <stdio.h>
#include <stdlib.h>

int main()
{
    int a[50], n, head, size;
    int i, j, temp, total = 0;

    printf("Enter number of requests: ");
    scanf("%d", &n);

    printf("Enter request sequence:\n");
    for(i = 0; i < n; i++)
        scanf("%d", &a[i]);

    printf("Enter initial head position: ");
    scanf("%d", &head);

    printf("Enter total number of cylinders: ");
    scanf("%d", &size);

    if(n < 0 || n > 50 || size <= 0 ||
       head < 0 || head >= size)
    {
        printf("Invalid input\n");
        return 1;
    }

    for(i = 0; i < n; i++)
    {
        if(a[i] < 0 || a[i] >= size)
        {
            printf("Invalid request\n");
            return 1;
        }
    }

    for(i = 0; i < n - 1; i++)
        for(j = i + 1; j < n; j++)
            if(a[i] > a[j])
            {
                temp = a[i];
                a[i] = a[j];
                a[j] = temp;
            }

    printf("\nSeek Sequence: %d", head);

    for(i = 0; i < n; i++)
        if(a[i] >= head)
            break;

    for(j = i; j < n; j++)
    {
        total += abs(head - a[j]);
        head = a[j];
        printf(" -> %d", head);
    }

    if(i > 0)
    {
        total += abs(head - (size - 1));
        head = size - 1;
        printf(" -> %d", head);

        total += size - 1;
        head = 0;
        printf(" -> %d", head);

        for(j = 0; j < i; j++)
        {
            total += abs(head - a[j]);
            head = a[j];
            printf(" -> %d", head);
        }
    }

    printf("\nTotal Head Movement = %d\n", total);

    return 0;
}
