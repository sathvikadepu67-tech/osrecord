
#include <stdio.h>

int main()
{
    int n, total, i, sum = 0;
    int pages[10], frames[10], rem[10];
    int used = 0, left, best;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    if(n <= 0 || n > 10)
    {
        printf("Invalid number of processes\n");
        return 1;
    }

    printf("Enter number of pages for each process:\n");

    for(i = 0; i < n; i++)
    {
        printf("P%d: ", i + 1);
        scanf("%d", &pages[i]);

        if(pages[i] < 0)
        {
            printf("Invalid page count\n");
            return 1;
        }

        sum += pages[i];
    }

    printf("Enter total number of frames: ");
    scanf("%d", &total);

    if(total < 0 || sum == 0)
    {
        printf("Invalid input\n");
        return 1;
    }

    for(i = 0; i < n; i++)
    {
        frames[i] = (pages[i] * total) / sum;
        rem[i] = (pages[i] * total) % sum;
        used += frames[i];
    }

    left = total - used;

    while(left > 0)
    {
        best = -1;

        for(i = 0; i < n; i++)
        {
            if(rem[i] >= 0 &&
               (best == -1 || rem[i] > rem[best]))
                best = i;
        }

        frames[best]++;
        rem[best] = -1;
        left--;
    }

    printf("\nProcess\tPages\tFrames Allocated\n");

    for(i = 0; i < n; i++)
        printf("P%d\t%d\t%d\n",
               i + 1, pages[i], frames[i]);

    return 0;
}
